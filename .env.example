# UniDeal Campus Marketplace Environment Configuration

# Server Port (Cloud platforms automatically provide this via $PORT)
PORT=5000

# Environment: 'development' or 'production'
NODE_ENV=development

# Secret key used for signing JWT tokens (use a random string in production)
JWT_SECRET=unideal-campus-jwt-secret-key-2025

# JWT Expiration Duration
JWT_EXPIRES_IN=7d

# Allowed CORS origins (set to specific cloud frontend URL or * for public API)
CLIENT_URL=*

# Custom API URL if hosting frontend separately from backend
# VITE_API_URL=https://your-backend.onrender.com/api
